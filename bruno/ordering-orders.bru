meta {
  name: Ordering API - Orders
  type: http
}

vars {
  baseUrl: http://localhost:8080
  orderId: 00000000-0000-0000-0000-000000000000
}

# Create Order
post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerName": "john",
    "itemName": "iphone",
    "quantity": 2,
    "price": 999.99,
    "status": "CREATED",
    "orderDate": "2026-01-30T10:00:00"
  }
}

---

# Get Order By Id
get {
  url: {{baseUrl}}/orders/{{orderId}}
  auth: none
}

---

# Get All Orders
get {
  url: {{baseUrl}}/orders
  auth: none
}

---

# Update Status
patch {
  url: {{baseUrl}}/orders/{{orderId}}/status
  auth: none
}

query {
  status: SHIPPED
}

---

# Update Order (PUT)
put {
  url: {{baseUrl}}/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerName": "john",
    "itemName": "iphone 15",
    "quantity": 3,
    "price": 1099.99,
    "status": "SHIPPED",
    "orderDate": "2026-01-30T10:05:00"
  }
}

---

# Delete Order
delete {
  url: {{baseUrl}}/orders/{{orderId}}
  auth: none
}