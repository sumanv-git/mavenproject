meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerName": "john",
    "itemName": "iphone",
    "quantity": 2,
    "price": 999.99,
    "status": "CREATED",
    "orderDate": "2026-01-30T10:00:00"
  }
}

script:post-response {
  const body = res.body;
  const id = body?.id ?? JSON.parse(res.bodyText || "{}")?.id;

  if (!id) throw new Error("Create order response did not contain 'id'");

  bru.setEnvVar("orderId", id);      // updates env var for subsequent requests
  // bru.setVar("orderId", id);      // alternatively: collection/runtime var (depends on your setup)
}
